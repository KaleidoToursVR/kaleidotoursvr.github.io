# Cloudflare Pages response headers.
# Content-hashed build files: cache for a year. HTML keeps the Pages default (revalidate).
/_astro/*
  Cache-Control: public, max-age=31536000, immutable

/images/*
  Cache-Control: public, max-age=604800

/video/*
  Cache-Control: public, max-age=604800

/wp-content/*
  Cache-Control: public, max-age=604800
